APP_NAME=enterprise-agentic-ai
ENVIRONMENT=development
LOG_LEVEL=INFO

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=
